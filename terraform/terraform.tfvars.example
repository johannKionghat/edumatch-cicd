# Copier en terraform.tfvars et ajuster si besoin — toutes les valeurs
# ci-dessous sont déjà les valeurs par défaut de variables.tf. Ce fichier
# n'est nécessaire que pour les documenter à un endroit unique et explicite ;
# `terraform.tfvars` reste ignoré par .gitignore (seul ce `.example` est
# versionné, comme pour les secrets applicatifs d'edumatch-ia).
#
# Aucun secret ici : project_id, access_key et secret_key Scaleway se
# passent en variables d'environnement (SCW_DEFAULT_PROJECT_ID, SCW_ACCESS_KEY,
# SCW_SECRET_KEY), jamais dans un fichier .tfvars — voir main.tf et le README.

region             = "fr-par"
zone               = "fr-par-1"
nom_projet         = "edumatch"
environnement      = "demo"
version_kubernetes = "1.36.4"
type_noeud         = "DEV1-M"
pool_taille_min    = 1
pool_taille_max    = 2

# ─── Instance Airflow (ADR 0019) ─────────────────────────────────────────
# Valeur factice ci-dessous pour cidr_operateur : à remplacer par sa propre
# adresse IP publique au format CIDR /32 avant tout `terraform plan`. Cette
# variable est obligatoire (pas de valeur par défaut dans variables.tf) :
# `curl -4 ifconfig.me` (ou tout service équivalent) donne l'adresse à
# utiliser, sous la forme "203.0.113.42/32".
type_instance_airflow    = "DEV1-L"
cidr_operateur           = "203.0.113.42/32" # FACTICE — à remplacer par sa propre IP
airflow_active           = false
taille_volume_airflow_go = 60
